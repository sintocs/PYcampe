# Frontend (optional: endpoint of the FastAPI API)
VITE_API_URL=http://localhost:8000/api/v1

# Backend
APP_ENV=development
DATABASE_URL=postgresql+psycopg://pycamp:pycamp@localhost:5432/pycamp
JWT_SECRET=replace-with-a-long-random-secret-before-deploying
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
CORS_ORIGINS=http://localhost:5173
MAX_SUBMISSION_BYTES=30000
RUN_TIMEOUT_SECONDS=2
MAX_OUTPUT_BYTES=10000
